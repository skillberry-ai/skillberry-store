# Demo access-control config. Puts the store in `standalone` mode with two
# pre-provisioned users so the demo is usable out-of-the-box.
#
# WARNING: passwords in this file are trivial ("skillberry" / "admin") and
# meant only for demos on a trusted machine. Never ship this file to a real
# deployment. See docs/design/access-control.md and access_control_demo.md.

mode: standalone

unauthenticated_paths:
  - GET /health
  - GET /health/ready
  - GET /admin/metrics
  - POST /auth/login
  - POST /auth/logout
  - GET /auth/whoami
  - GET /docs
  - GET /openapi.json
  - GET /redoc
  # Root redirect and SPA deep-links → /ui: public, no auth needed.
  - GET /
  - GET /ui*
  - HEAD /ui*
  - GET /control_sse*
  - POST /control_sse*

# --- Mode-specific: standalone only -------------------------------------
standalone:
  session_ttl_seconds: 43200          # 12h; env: SBS_SESSION_TTL
  users:
    - username: skillberry
      tenant_id: skillberry
      password_hash: '$2b$12$z1CKK7qHY.6ZlEAHbKBfDO5s/mWZin.SpU.iHyseaeOkUeOIqZZc2'
      groups: []
    - username: skillberry-admin
      tenant_id: skillberry-admin
      password_hash: '$2b$12$ssgkuUTSeR5B6mAJyoNm2udcEs2DcX5Kq4XuTYUnqrx3hO/DBy67e'
      groups: []

  # Informational message shown at login (UI sign-in screen and `sbs login`).
  # Both controls are independent: `enabled` gates the display, `message` holds
  # the text. Plain text only — line breaks via the `|` block scalar, capped at
  # 1024 characters / 10 lines. See docs/design/login-info.md.
  #
  # WARNING: this message is served PRE-AUTHENTICATION to anyone who can reach
  # /ui/ or GET /auth/whoami. It must contain NO SECRETS. That it sits in the
  # same file as the bcrypt password hashes does not make it confidential.
  login_info:
    enabled: false
    message: |
      Demo deployment with well-known passwords — do not store secrets here.
      Sign in as `skillberry` or `skillberry-admin`.

# --- RBAC ---------------------------------------------------------------
roles:
  - name: reader
    rules:
      - resources: [skills, tools, snippets, vmcp_servers, vnfs_servers,
                    facets, plugins, system]
        verbs: [list, get, search]

  - name: content-author
    rules:
      - resources: [skills, tools, snippets]
        verbs: [list, get, search, create, update, delete]

  - name: tool-runner
    rules:
      - resources: [tools, vmcp_servers, vnfs_servers]
        verbs: [execute]

  - name: server-operator
    rules:
      - resources: [vmcp_servers, vnfs_servers]
        verbs: [list, get, create, update, delete, execute]

  - name: admin
    rules:
      - resources: ["*"]
        verbs: ["*"]

  - name: base-user
    rules:
      - resources: [skills, tools, snippets, vmcp_servers, vnfs_servers,
                    facets, plugins, system]
        verbs: [list, get, search, execute]


  # Identity a plugin's autonomous work runs as (plugin-identity §5.3). Content
  # authorship, tool execution and virtual-server publication — nothing more. It
  # never mentions the `admin` resource, so /admin/backup, /admin/restore and
  # /admin/purge-all are out of reach by construction rather than by omission.
  - name: plugin-agent
    rules:
      - resources: [skills, tools, snippets]
        verbs: [list, get, search, create, update, delete]
                                                     # delete: `simulate` removes
                                                     # the sim skill/tools it
                                                     # created, on teardown
      - resources: [tools]
        verbs: [execute]                             # StoreAPI.execute_tool —
                                                     # dast's benign twin runs the
                                                     # skill's own tools through
                                                     # the store's execution path
      - resources: [vmcp_servers, vnfs_servers]
        verbs: [list, get, create, update, delete, execute]
                                                     # execute == start; this is
                                                     # what export over vNFS /
                                                     # WebDAV / vMCP requires
      - resources: [facets, plugins]
        verbs: [list, get, search]

bindings:
  - name: skillberry-base
    subjects:
      - kind: tenant
        name: skillberry
    roles: [base-user]

  - name: skillberry-admin
    subjects:
      - kind: tenant
        name: skillberry-admin
    roles: [admin]

  # `plugin-user` is deliberately a VIRTUAL subject: it appears in roles and
  # bindings so its grants are reviewable in the same file as every other grant,
  # but it has NO `standalone.users` entry — therefore no password hash, and no
  # way to log in from the network. `POST /auth/login` as plugin-user returns
  # invalid_credentials like any unknown user, so the identity is unforgeable
  # from outside: no credential for it exists anywhere.
  - name: plugin-agent-binding
    subjects:
      - kind: tenant
        name: plugin-user
    roles: [plugin-agent]

# --- Plugin identity ----------------------------------------------------
# Deployment-wide fallback identity for plugin work that no per-plugin owner
# covers. Precedence: the owner recorded when a tenant enabled the plugin (see
# PATCH /plugins/{name}) -> this -> none, in which case the plugin's outward
# calls FAIL rather than proceeding anonymously (P5).
#
# Shipping a default matters: with triggers running as the owner tenant, a
# deployment with no default has seven auto-triggering plugins whose first
# import fails silently on the event path.
plugins:
  owner_tenant: plugin-user
  # Groups to attribute to the owner tenant (it has no users entry of its own).
  owner_groups: []
  # Tokens minted for a plugin's out-of-process calls are short-lived and
  # refreshed on demand rather than held for a session's lifetime.
  token_ttl_seconds: 900
